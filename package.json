{
  "name": "pixellab-backpack",
  "private": true,
  "version": "0.2.0",
  "description": "Keep your PixelLab art packed in one place. Browse, search, play and organize images.",
  "license": "MIT",
  "repository": "github:Shilo/pixellab-backpack",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent --port 5281 --strictPort",
    "build": "vite build && node scripts/dist-guard.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "25.9.9",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
