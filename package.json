{
  "name": "pixellab-backpack",
  "private": true,
  "version": "0.2.0",
  "description": "Keep your PixelLab art packed in one place. Browse, search, play and organize images.",
  "license": "MIT",
  "repository": "github:Shilo/pixellab-backpack",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --mode agent --port 5281 --strictPort",
    "build": "vite build && node scripts/dist-guard.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=desktop --workers=1 --grep \"good key opens the library|a deep link reload opens the viewer|U4: at 320 px|shared token:|framed app\""
  },
  "dependencies": {
    "@jungherz-de/glasskit": "1.27.0",
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  }
}
